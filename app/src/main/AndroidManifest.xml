<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dangerous runtime permission, requested only by an explicit user action in Settings; see
         docs/product/workspaces-sources-lenses.md (Calendar access policy). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The Dock's first-run apps are found by role or intent (AndroidDockDefaultsResolver): dialer, SMS,
             browser and camera. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />

            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />

            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Media apps that can be resumed from the Stream's recent players (Now): the apps with a browser service. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Riffle">
        <!-- The Home activity declares what AOSP's Launcher3 does (home-gesture-after-update investigation): its saved
             state is never needed, re-launching it from Home returns to its root (nothing the app relies on lives
             above it in its task: the diagnostics activities start their own tasks), and it resumes while another
             activity is still pausing. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Riffle"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- App pair experiment (Settings > About > Diagnostics): starts two apps from a window that is on screen. -->
        <activity
            android:name=".launcher.diagnostics.pair.PairTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Riffle.PairTrampoline" />
        <!-- App pair experiment, round 3: a resizable, opaque holding window that starts the pair from a split. -->
        <activity
            android:name=".launcher.diagnostics.pair.PairHolderActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Riffle.PairHolder" />
        <!-- Round 4, probe P2: as above, but listed in Recents and with an affinity of its own. -->
        <activity
            android:name=".launcher.diagnostics.pair.PairHolderListedActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:label="@string/app_pair_holder_listed_label"
            android:resizeableActivity="true"
            android:taskAffinity=".pairholder"
            android:theme="@style/Theme.Riffle.PairHolder" />
        <service
            android:name=".launcher.notifications.RiffleNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".launcher.overlay.OverlayDockService"
            android:exported="false" />
    </application>

</manifest>

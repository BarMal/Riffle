<resources>
    <style name="Theme.Riffle" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Show the wallpaper from the first frame so a cold start never flashes the theme's
             window colour; LauncherWallpaperController switches to a solid colour when chosen. -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <!-- The app pair experiment's trampoline: nothing is drawn. -->
    <style name="Theme.Riffle.PairTrampoline" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
    <!-- The app pair experiment's holding window: a plain opaque surface the system can put on one side of a split. -->
    <style name="Theme.Riffle.PairHolder" parent="android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>

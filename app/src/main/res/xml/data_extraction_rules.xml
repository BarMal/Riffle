<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) Auto Backup / device-transfer rules.

  The offline RSS article cache (DataStore file "riffle_rss_article_cache") is device-local
  persistence: normalized article content, optional cached images, and opaque read/dismiss
  digests. It must never be included in cloud backup or device-to-device transfer: it is cache
  content, not user configuration, and restoring it would be meaningless without a matching
  refresh (which restore must never trigger automatically). See issue #1010.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/riffle_rss_article_cache.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/riffle_rss_article_cache.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
